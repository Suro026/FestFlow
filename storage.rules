rules_version = '2';

// Firebase Storage rules.
//
// Same principle as Firestore: these are the boundary, not the upload widget.
// Every path is denied by default and opened deliberately.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? (request.auth.token.role is string ? request.auth.token.role : 'student')
        : '';
    }

    function isOrganizer() { return role() in ['organizer', 'admin', 'super_admin']; }
    function isAdmin()     { return role() in ['admin', 'super_admin']; }

    // Uploads are capped and type-checked here rather than in the UI, because
    // the UI is not what an attacker uses. Without a size cap, one request can
    // put a multi-gigabyte file on a pay-as-you-go bill.
    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Fest banners and logos. Public to read, staff to write.
    match /fests/{festId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    // Event posters.
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isOrganizer() && isImage();
    }

    // Profile photos, written only by their owner.
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && isImage();
    }

    // Generated certificate PDFs.
    //
    // Read is restricted to the recipient and to staff. Write is server-only:
    // the Admin SDK bypasses these rules, so a client can never place a file
    // where a certificate is expected to be.
    match /certificates/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isOrganizer());
      allow write: if false;
    }

    // Uploaded result sheets (CSV/XLSX) kept for audit.
    match /results/{eventId}/{fileName} {
      allow read: if isOrganizer();
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
