rules_version = '2';

// Firebase Storage rules.
//
// Every write goes through POST /api/uploads (images) or the certificate
// pipeline (PDFs), where the bytes are sniffed, re-encoded, size-capped and
// given a random name before the Admin SDK stores them. The Admin SDK
// bypasses these rules, so the rules' job is simple: nobody else writes,
// and reads are as narrow as the product allows.
//
// Object layout (all names are server-generated UUIDs):
//   fests/{festId}/banners|logos|posters/{uuid}.{png|jpg|webp}   public read
//   users/{uid}/photo/{uuid}.{png|jpg|webp}                       public read
//   certificates/{uid}/{certificateNumber}.pdf                    owner + staff
//   results/{eventId}/{file}                                      staff only

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn()
        ? (request.auth.token.role is string ? request.auth.token.role : 'student')
        : '';
    }

    function isOrganizer() { return role() in ['organizer', 'admin', 'super_admin']; }

    // Fest artwork: banners, logos, event posters. Shown on public pages.
    match /fests/{festId}/{folder}/{fileName} {
      allow read: if folder in ['banners', 'logos', 'posters'];
      allow write: if false;
    }

    // Profile photos. Shown to teammates and staff; public read keeps the
    // <img> simple and the photo is chosen by its owner for that purpose.
    match /users/{userId}/photo/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Generated certificate PDFs: the recipient and staff. Never client-written.
    match /certificates/{userId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isOrganizer());
      allow write: if false;
    }

    // Uploaded result sheets kept for audit: staff only, server-written.
    match /results/{eventId}/{fileName} {
      allow read: if isOrganizer();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
