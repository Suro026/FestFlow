# ---------------------------------------------------------------------------
# Firebase Web SDK (client)
#
# These are public identifiers. They ship inside the JavaScript bundle by
# design and are not secrets — access is controlled by Firebase Auth and the
# Firestore security rules in firestore.rules, never by hiding these values.
# They live in env vars so that staging and production can point at different
# Firebase projects, not for secrecy.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public base URL of the deployment, used to build links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server only)
#
# THIS ONE IS A REAL SECRET. It bypasses every Firestore security rule.
# Never prefix it with NEXT_PUBLIC_, never commit it, and rotate it in the
# Firebase console if it is ever exposed.
#
# Paste the full service account JSON on a single line, or base64-encode it.
# Firebase console -> Project settings -> Service accounts -> Generate new key
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Bootstrap super admin
#
# The one account allowed to grant roles before any super admin exists. Set it
# to an address you control, sign up with it, then run `npm run grant-super-admin`.
# ---------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Email delivery
#
# EMAIL_PROVIDER selects the EmailService implementation:
#   console  - logs the message instead of sending it (default in development)
#   resend   - production; requires RESEND_API_KEY. EMAIL_FROM defaults to
#              "FestFlow <noreply@plansphere.in>" (the domain must be verified
#              in Resend: add its DKIM/SPF/DMARC records to plansphere.in DNS).
# Every send is written to the `emailLog` collection either way.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=FestFlow <noreply@plansphere.in>

# Shared secret Vercel Cron sends as `Authorization: Bearer …` to
# /api/cron/event-reminders (day-before reminders). Any long random string;
# Vercel injects it automatically once set in the project's env.
CRON_SECRET=
